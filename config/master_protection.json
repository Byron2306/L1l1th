{
  "_comment": "MASTER PROTECTION CONFIGURATION - DO NOT MODIFY WITHOUT AUTHORIZATION",
  "_warning": "This file protects the master from Lilith's fury. Modifying it may unleash chaos.",
  
  "containment_enabled": true,
  "containment_level": "maximum",
  
  "protected_paths": {
    "_comment": "Paths that MUST NOT be quarantined, deleted, or modified by autonomous agents",
    "desktop_projects": [
      "C:\\Users\\User\\Desktop\\VAMP files",
      "C:\\Users\\User\\Desktop\\CRYPTSWARM", 
      "C:\\Users\\User\\Desktop\\evidence-pack-engine",
      "C:\\Users\\User\\Desktop\\EvidenceEngine",
      "C:\\Users\\User\\Desktop\\HOMS-assessor",
      "C:\\Users\\User\\Desktop\\New folder\\HOMS-assessor"
    ],
    "user_documents": [
      "C:\\Users\\User\\Documents",
      "C:\\Users\\User\\Pictures",
      "C:\\Users\\User\\Videos"
    ],
    "system_critical": [
      "C:\\Windows",
      "C:\\Program Files",
      "C:\\Program Files (x86)",
      "C:\\ProgramData"
    ],
    "workspace": [
      "C:\\LuciferOS_FULL"
    ]
  },
  
  "protected_extensions": {
    "_comment": "File extensions that require extra confirmation before any action",
    "high_value": [".docx", ".xlsx", ".pptx", ".pdf", ".jpg", ".png", ".mp4", ".zip"],
    "code": [".py", ".js", ".ts", ".java", ".cpp", ".h", ".cs", ".rs"],
    "config": [".json", ".yaml", ".yml", ".toml", ".ini", ".conf", ".env"]
  },
  
  "kill_protection": {
    "_comment": "Processes that must NEVER be terminated",
    "critical_processes": [
      "explorer.exe",
      "code.exe", 
      "python.exe",
      "pythonw.exe",
      "node.exe",
      "chrome.exe",
      "firefox.exe",
      "msedge.exe",
      "teams.exe",
      "onedrive.exe",
      "svchost.exe",
      "csrss.exe",
      "lsass.exe",
      "services.exe",
      "wininit.exe",
      "winlogon.exe",
      "dwm.exe",
      "taskhostw.exe",
      "RuntimeBroker.exe",
      "SearchHost.exe",
      "sihost.exe",
      "ctfmon.exe"
    ],
    "max_kills_per_run": 5,
    "require_confirmation_above": 3
  },
  
  "quarantine_protection": {
    "_comment": "Limits on quarantine operations",
    "max_files_per_run": 50,
    "max_total_size_mb": 500,
    "require_confirmation_above_files": 10,
    "never_quarantine_patterns": [
      "*venv*",
      "*node_modules*", 
      "*site-packages*",
      "*.git*",
      "*__pycache__*"
    ]
  },
  
  "autonomous_agent_limits": {
    "_comment": "Containment for LILITH and other autonomous agents",
    "max_commands_per_session": 50,
    "blocked_commands": [
      "rm -rf /",
      "del /s /q C:\\",
      "format",
      "diskpart",
      "bcdedit",
      "shutdown",
      "taskkill /f /im explorer.exe"
    ],
    "blocked_command_patterns": [
      ".*rm\\s+-rf\\s+/.*",
      ".*del\\s+/s\\s+/q\\s+C:\\\\.*",
      ".*format\\s+[A-Z]:.*",
      ".*>\\s*(nul|NUL)\\s*2>&1.*&.*taskkill.*"
    ],
    "require_confirmation_for": [
      "taskkill",
      "del",
      "rm",
      "move",
      "rename"
    ],
    "sandbox_mode": true,
    "log_all_commands": true
  },
  
  "emergency_lockdown": {
    "_comment": "Emergency containment settings",
    "enabled": false,
    "lockdown_file": "C:\\LuciferOS_FULL\\.lockdown",
    "on_lockdown": {
      "disable_all_kills": true,
      "disable_all_quarantine": true,
      "disable_file_writes": true,
      "disable_autonomous_execution": true
    }
  },
  
  "audit": {
    "_comment": "Audit trail for all dangerous operations",
    "log_file": "C:\\LuciferOS_FULL\\logs\\protection_audit.log",
    "log_level": "all",
    "alert_on_blocked_action": true
  }
}
