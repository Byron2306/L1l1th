# Custom kernel config for LuciferOS
# Optimized for security testing, persistence, and evasion

CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_REDUCED=n

# Rootkit & persistence support
CONFIG_HAVE_KPROBES=y
CONFIG_KPROBES=y
CONFIG_KRETPROBES=y
CONFIG_FTRACE=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_FUNCTION_TRACER=y

# Process injection support
CONFIG_HAVE_IOREMAP_PROT=y
CONFIG_STRICT_KERNEL_RWX=n
CONFIG_DEBUG_RODATA=n

# Memory forensics
CONFIG_HAVE_MEMBLOCK=y
CONFIG_MEMBLOCK_VERBOSE=y

# Network capabilities
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_PACKET_DIAG=y

# Encryption & security
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_GCM=y
CONFIG_DM_CRYPT=y
CONFIG_DM_INTEGRITY=y
