[Unit]
Description=LUCIFER-OS Backend Service
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/workspaces/LUCIFER-OS
ExecStart=/workspaces/LUCIFER-OS/start_backend.sh
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=PYTHONPATH=/workspaces/LUCIFER-OS

[Install]
WantedBy=multi-user.target