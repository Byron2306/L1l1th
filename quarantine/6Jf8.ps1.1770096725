# Start the Docker Compose stack and open the UI URL when ready
param(
    [int]$Port = 5000,
    [int]$TimeoutSeconds = 60
)
$composeFile = "docker/docker-compose.yml"
Write-Host "Starting Docker Compose (detached, build)..."
docker compose -f $composeFile up -d --build

$start = Get-Date
while ((New-TimeSpan -Start $start).TotalSeconds -lt $TimeoutSeconds) {
    try {
        $resp = Invoke-WebRequest -Uri "http://127.0.0.1:$Port/" -UseBasicParsing -TimeoutSec 3
        if ($resp.StatusCode -ge 200 -and $resp.StatusCode -lt 400) {
            Write-Host "UI is up — opening http://127.0.0.1:$Port"
            Start-Process "http://127.0.0.1:$Port"
            exit 0
        }
    } catch {
        Start-Sleep -Seconds 1
    }
}
Write-Host "Timed out waiting for UI on port $Port after $TimeoutSeconds seconds. You can check containers with 'docker ps' and view logs with 'docker logs swarm-agent'."; exit 1
