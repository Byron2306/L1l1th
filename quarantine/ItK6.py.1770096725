import logging
import json
import csv
import os
from datetime import datetime
from typing import List, Dict, Any


def setup_logging():
    logging.basicConfig(
        level=logging.INFO,
        format="%(asctime)s | %(levelname)s | %(message)s",
    )


class LoggingAnalyticsAgent:
    def __init__(self, log_dir: str = "logs"):
        self.log_dir = log_dir
        os.makedirs(log_dir, exist_ok=True)
        self.trade_log_file = os.path.join(log_dir, "trades.csv")
        self.metrics_file = os.path.join(log_dir, "metrics.json")
        self.trades = self._load_trades()
        self.metrics = self._load_metrics()

    def _load_trades(self) -> List[Dict[str, Any]]:
        if os.path.exists(self.trade_log_file):
            with open(self.trade_log_file, 'r') as f:
                reader = csv.DictReader(f)
                return list(reader)
        return []

    def _save_trades(self):
        if self.trades:
            with open(self.trade_log_file, 'w', newline='') as f:
                writer = csv.DictWriter(f, fieldnames=self.trades[0].keys())
                writer.writeheader()
                writer.writerows(self.trades)

    def _load_metrics(self) -> Dict[str, Any]:
        if os.path.exists(self.metrics_file):
            with open(self.metrics_file, 'r') as f:
                return json.load(f)
        return {"total_trades": 0, "wins": 0, "losses": 0, "profit_loss": 0.0, "win_rate": 0.0, "max_drawdown": 0.0}

    def _save_metrics(self):
        with open(self.metrics_file, 'w') as f:
            json.dump(self.metrics, f, indent=4)

    def log_trade(self, trade: Dict[str, Any]):
        """Log a trade: {"timestamp", "symbol", "side", "quantity", "price", "order_id", "status"}"""
        trade["timestamp"] = datetime.now().isoformat()
        self.trades.append(trade)
        self._save_trades()
        logging.info(f"Trade logged: {trade}")

    def update_metrics(self, new_trade: Dict[str, Any]):
        """Update performance metrics after a trade."""
        self.metrics["total_trades"] += 1
        # Assume profit/loss calculation; in real, compare entry/exit prices
        # Placeholder: assume all trades are profitable for demo
        if new_trade.get("side") == "BUY":
            self.metrics["profit_loss"] += float(new_trade.get("quantity", 0)) * float(new_trade.get("price", 0)) * 0.01  # dummy profit
        else:
            self.metrics["profit_loss"] -= float(new_trade.get("quantity", 0)) * float(new_trade.get("price", 0)) * 0.01

        self.metrics["wins"] = sum(1 for t in self.trades if t.get("profit", 0) > 0)
        self.metrics["losses"] = self.metrics["total_trades"] - self.metrics["wins"]
        self.metrics["win_rate"] = self.metrics["wins"] / self.metrics["total_trades"] if self.metrics["total_trades"] > 0 else 0.0
        # Max drawdown placeholder
        self.metrics["max_drawdown"] = min(self.metrics.get("max_drawdown", 0), self.metrics["profit_loss"])
        self._save_metrics()
        logging.info(f"Metrics updated: {self.metrics}")

    def generate_report(self) -> str:
        """Generate a simple text report."""
        report = f"""
Trading Report
==============
Total Trades: {self.metrics['total_trades']}
Wins: {self.metrics['wins']}
Losses: {self.metrics['losses']}
Win Rate: {self.metrics['win_rate']:.2%}
Profit/Loss: {self.metrics['profit_loss']:.2f}
Max Drawdown: {self.metrics['max_drawdown']:.2f}
"""
        report_file = os.path.join(self.log_dir, "report.txt")
        with open(report_file, 'w') as f:
            f.write(report)
        logging.info(f"Report generated: {report_file}")
        return report

    def get_recent_trades(self, limit: int = 10) -> List[Dict[str, Any]]:
        return self.trades[-limit:]

    def get_metrics(self) -> Dict[str, Any]:
        return self.metrics