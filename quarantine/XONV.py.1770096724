import redis
import json
import logging
from typing import Any, Dict, Optional


class NetworkAgent:
    """
    Network Agent: Manages communication and data sharing between agents using Redis.
    Provides pub/sub messaging and caching for reliable, real-time data flow.
    """

    def __init__(self, host: str = "localhost", port: int = 6379, db: int = 0, password: Optional[str] = None):
        self.host = host
        self.port = port
        self.db = db
        self.password = password
        self.client = None
        self.pubsub = None
        self._connect()

    def _connect(self):
        """Establish Redis connection."""
        try:
            self.client = redis.Redis(
                host=self.host,
                port=self.port,
                db=self.db,
                password=self.password,
                decode_responses=True  # For string responses
            )
            self.pubsub = self.client.pubsub()
            self.client.ping()  # Test connection
            logging.info(f"Network Agent connected to Redis at {self.host}:{self.port}")
        except redis.ConnectionError as e:
            logging.error(f"Failed to connect to Redis: {e}")
            self.client = None
            self.pubsub = None

    def is_connected(self) -> bool:
        """Check if Redis is connected."""
        return self.client is not None and self.client.ping() is not None

    def publish(self, channel: str, message: Any):
        """Publish a message to a channel."""
        if not self.is_connected():
            logging.warning("Redis not connected, cannot publish")
            return
        try:
            data = json.dumps(message) if not isinstance(message, str) else message
            self.client.publish(channel, data)
            logging.debug(f"Published to {channel}: {data}")
        except Exception as e:
            logging.error(f"Error publishing to {channel}: {e}")

    def subscribe(self, channels: list, callback):
        """Subscribe to channels with a callback function."""
        if not self.is_connected():
            logging.warning("Redis not connected, cannot subscribe")
            return
        try:
            self.pubsub.subscribe(**{ch: callback for ch in channels})
            logging.info(f"Subscribed to channels: {channels}")
            # Note: Listening should be in a thread
        except Exception as e:
            logging.error(f"Error subscribing to {channels}: {e}")

    def set_cache(self, key: str, value: Any, expire: Optional[int] = None):
        """Set a cached value."""
        if not self.is_connected():
            logging.warning("Redis not connected, cannot cache")
            return
        try:
            data = json.dumps(value) if not isinstance(value, str) else value
            self.client.set(key, data, ex=expire)
            logging.debug(f"Cached {key}: {data}")
        except Exception as e:
            logging.error(f"Error caching {key}: {e}")

    def get_cache(self, key: str) -> Optional[Any]:
        """Get a cached value."""
        if not self.is_connected():
            logging.warning("Redis not connected, cannot get cache")
            return None
        try:
            data = self.client.get(key)
            if data:
                return json.loads(data)
            return None
        except Exception as e:
            logging.error(f"Error getting cache {key}: {e}")
            return None

    def delete_cache(self, key: str):
        """Delete a cached value."""
        if not self.is_connected():
            return
        try:
            self.client.delete(key)
            logging.debug(f"Deleted cache {key}")
        except Exception as e:
            logging.error(f"Error deleting cache {key}: {e}")

    def listen(self):
        """Listen for messages (call in a thread)."""
        if not self.pubsub:
            return
        for message in self.pubsub.listen():
            if message['type'] == 'message':
                # Handled by callback
                pass

    def share_data(self, key: str, data: Any):
        """Share data via cache and publish update."""
        self.set_cache(key, data)
        self.publish(f"data:{key}", data)

    def get_shared_data(self, key: str) -> Optional[Any]:
        """Get shared data from cache."""
        return self.get_cache(key)

    def close(self):
        """Close connections."""
        if self.pubsub:
            self.pubsub.close()
        if self.client:
            self.client.close()
        logging.info("Network Agent connections closed")