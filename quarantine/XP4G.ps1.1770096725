$p = 'C:\Users\User\AppData\Roaming\Python\Python314\Scripts'
$u = [Environment]::GetEnvironmentVariable('Path','User')
if ([string]::IsNullOrEmpty($u)) {
    [Environment]::SetEnvironmentVariable('Path', $p, 'User')
    Write-Output "Set new User PATH: $p"
} elseif ($u -notlike "*$p*") {
    [Environment]::SetEnvironmentVariable('Path', "$u;$p", 'User')
    Write-Output "Added to User PATH: $p"
} else {
    Write-Output "Already in User PATH: $p"
}
