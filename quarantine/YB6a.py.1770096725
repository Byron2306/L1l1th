import psutil
import time
import logging
from typing import Dict, Any, Optional
from datetime import datetime


class PerformanceAgent:
    """
    Performance Agent: Monitors system resources and agent performance.
    Tracks CPU, memory, network usage, and agent health metrics.
    """

    def __init__(self, monitor_interval: int = 60):
        self.monitor_interval = monitor_interval
        self.metrics = {}
        self.agent_health = {}
        self.running = False

    def start_monitoring(self):
        """Start performance monitoring in a thread."""
        self.running = True
        import threading
        thread = threading.Thread(target=self._monitor_loop, daemon=True)
        thread.start()
        logging.info("Performance Agent monitoring started")

    def stop_monitoring(self):
        """Stop performance monitoring."""
        self.running = False
        logging.info("Performance Agent monitoring stopped")

    def _monitor_loop(self):
        """Main monitoring loop."""
        while self.running:
            try:
                self._collect_system_metrics()
                time.sleep(self.monitor_interval)
            except Exception as e:
                logging.error(f"Error in performance monitoring: {e}")
                time.sleep(self.monitor_interval)

    def _collect_system_metrics(self):
        """Collect system performance metrics."""
        try:
            timestamp = datetime.now().isoformat()

            # CPU metrics
            cpu_percent = psutil.cpu_percent(interval=1)
            cpu_count = psutil.cpu_count()

            # Memory metrics
            memory = psutil.virtual_memory()
            memory_percent = memory.percent
            memory_used = memory.used / (1024**3)  # GB
            memory_total = memory.total / (1024**3)  # GB

            # Disk metrics
            disk = psutil.disk_usage('/')
            disk_percent = disk.percent
            disk_used = disk.used / (1024**3)  # GB
            disk_total = disk.total / (1024**3)  # GB

            # Network metrics
            net = psutil.net_io_counters()
            bytes_sent = net.bytes_sent / (1024**2)  # MB
            bytes_recv = net.bytes_recv / (1024**2)  # MB

            self.metrics[timestamp] = {
                'cpu_percent': cpu_percent,
                'cpu_count': cpu_count,
                'memory_percent': memory_percent,
                'memory_used_gb': memory_used,
                'memory_total_gb': memory_total,
                'disk_percent': disk_percent,
                'disk_used_gb': disk_used,
                'disk_total_gb': disk_total,
                'net_bytes_sent_mb': bytes_sent,
                'net_bytes_recv_mb': bytes_recv
            }

            logging.debug(f"Collected performance metrics: CPU {cpu_percent}%, Memory {memory_percent}%")

        except Exception as e:
            logging.error(f"Error collecting system metrics: {e}")

    def get_current_metrics(self) -> Dict[str, Any]:
        """Get the most recent performance metrics."""
        if self.metrics:
            latest_timestamp = max(self.metrics.keys())
            return self.metrics[latest_timestamp]
        return {}

    def get_metrics_history(self, limit: int = 10) -> Dict[str, Any]:
        """Get historical performance metrics."""
        sorted_timestamps = sorted(self.metrics.keys(), reverse=True)
        return {ts: self.metrics[ts] for ts in sorted_timestamps[:limit]}

    def update_agent_health(self, agent_name: str, status: str, details: Optional[Dict] = None):
        """Update health status for an agent."""
        self.agent_health[agent_name] = {
            'status': status,
            'timestamp': datetime.now().isoformat(),
            'details': details or {}
        }
        logging.info(f"Agent {agent_name} health updated: {status}")

    def get_agent_health(self, agent_name: Optional[str] = None) -> Dict[str, Any]:
        """Get health status for agents."""
        if agent_name:
            return self.agent_health.get(agent_name, {})
        return self.agent_health

    def check_system_health(self) -> Dict[str, Any]:
        """Perform a comprehensive system health check."""
        metrics = self.get_current_metrics()
        health_status = "healthy"

        # Check CPU usage
        if metrics.get('cpu_percent', 0) > 90:
            health_status = "critical"
        elif metrics.get('cpu_percent', 0) > 75:
            health_status = "warning"

        # Check memory usage
        if metrics.get('memory_percent', 0) > 90:
            health_status = "critical"
        elif metrics.get('memory_percent', 0) > 80:
            health_status = "warning"

        # Check disk usage
        if metrics.get('disk_percent', 0) > 95:
            health_status = "critical"
        elif metrics.get('disk_percent', 0) > 85:
            health_status = "warning"

        return {
            'overall_status': health_status,
            'metrics': metrics,
            'agent_health': self.agent_health,
            'timestamp': datetime.now().isoformat()
        }

    def track_system_metrics(self):
        """Track current system metrics."""
        self._collect_system_metrics()

    def track_response_time(self, operation: str, start_time: float):
        """Track response time for an operation."""
        response_time = time.time() - start_time
        timestamp = datetime.now().isoformat()
        
        if not hasattr(self, 'response_times'):
            self.response_times = {}
        
        if operation not in self.response_times:
            self.response_times[operation] = []
        
        self.response_times[operation].append({
            'timestamp': timestamp,
            'response_time': response_time
        })
        
        # Keep only last 100 entries
        if len(self.response_times[operation]) > 100:
            self.response_times[operation] = self.response_times[operation][-100:]
        
        logging.debug(f"Tracked {operation} response time: {response_time:.4f}s")