class TrendAnalysis:
    """
    Basic trend analysis.
    """
    @staticmethod
    def is_uptrend(closes: List[float]) -> bool:
        if len(closes) < 2:
            return False
        return closes[-1] > closes[0]

    @staticmethod
    def average_volume(volumes: List[float]) -> float:
        return sum(volumes) / len(volumes) if volumes else 0