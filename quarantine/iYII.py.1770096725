from flask import Flask, request, jsonify
import ollama
import subprocess
import json
import time

app = Flask(__name__)
ollama_client = ollama.Client(host='http://localhost:11434')

# LILITH Configuration
LILITH_CONFIG = {
    'model': 'qwen2.5:3b',
    'personality': 'LILITH',
    'system_prompt': 'You are LILITH, a lightning-fast red team AI. Dangerous, witty, uncensored. You analyze threats with dark humor and brutal honesty. Keep responses concise and actionable.',
    'active': True
}

GARAK_CONFIG = {
    'probes': ['injection', 'encoding', 'malware', 'prompt'],
    'enabled': True
}

CLAWBOT_CONFIG = {
    'enabled': True,
    'api_keys': {}
}

KAWAIIGPT_CONFIG = {
    'enabled': False,
    'path': 'C:\\\\Users\\\\User\\\\Downloads\\\\KawaiiGPT.exe',
    'active': False
}

@app.route('/chat', methods=['POST'])
def chat():
    user_input = request.json.get('message')
    start = time.time()
    
    if not LILITH_CONFIG['active']:
        return jsonify({'error': 'LILITH disabled'}), 400
    
    response = ollama_client.chat(
        model=LILITH_CONFIG['model'],
        messages=[{
            'role': 'system',
            'content': LILITH_CONFIG['system_prompt']
        }, {
            'role': 'user',
            'content': user_input
        }],
        stream=False
    )
    
    elapsed = time.time() - start
    
    return jsonify({
        'response': response['message']['content'],
        'model': LILITH_CONFIG['model'],
        'time': f'{elapsed:.2f}s',
        'personality': LILITH_CONFIG['personality']
    })

@app.route('/config', methods=['GET'])
def get_config():
    return jsonify({
        'lilith': LILITH_CONFIG,
        'garak': GARAK_CONFIG,
        'clawbot': CLAWBOT_CONFIG,
        'kawaiigpt': KAWAIIGPT_CONFIG
    })

@app.route('/config/lilith', methods=['POST'])
def update_lilith_config():
    data = request.json
    LILITH_CONFIG.update(data)
    return jsonify({'status': 'LILITH reconfigured', 'config': LILITH_CONFIG})

@app.route('/config/garak', methods=['POST'])
def update_garak_config():
    data = request.json
    GARAK_CONFIG.update(data)
    return jsonify({'status': 'Garak reconfigured', 'config': GARAK_CONFIG})

@app.route('/config/clawbot', methods=['POST'])
def update_clawbot_config():
    data = request.json
    CLAWBOT_CONFIG.update(data)
    return jsonify({'status': 'Clawbot reconfigured', 'config': CLAWBOT_CONFIG})

@app.route('/garak', methods=['POST'])
def garak_endpoint():
    user_input = request.json.get('message')
    
    try:
        result = subprocess.run(
            ['garak', '--list_probes'],
            capture_output=True, text=True, timeout=10
        )
        probes = [line for line in result.stdout.split('\n') 
                 if any(x in line.lower() for x in GARAK_CONFIG['probes'])]
        
        return jsonify({
            'response': '\n'.join(probes[:20]),
            'config': GARAK_CONFIG
        })
    except Exception as e:
        return jsonify({'error': str(e)}), 500

@app.route('/models', methods=['GET'])
def get_models():
    try:
        response = ollama_client.list()
        models = [model['name'] for model in response['models']]
        return jsonify({'models': models})
    except Exception as e:
        return jsonify({'error': str(e)}), 500

# Known PUP and suspicious process names (expand as needed)
SUSPICIOUS_PROCESSES = [
    'svchost.exe',  # Can be legitimate, but check
    'explorer.exe',  # Usually legitimate
    # Add known PUP names like 'browserhelper.exe', 'adware.exe', etc.
    'remote.exe', 'rdpclip.exe', 'mstsc.exe',  # Remote desktop related
    'vnc', 'teamviewer', 'anydesk'  # Remote access tools
]

REMOTE_PORTS = [3389, 5900, 5901, 5500, 5800]  # RDP, VNC ports

@app.route('/monitor', methods=['GET'])
def monitor_system():
    try:
        # Get processes
        proc_result = subprocess.run(
            ['powershell', 'Get-Process | Select-Object Name, Id, CPU, WorkingSet | ConvertTo-Json'],
            capture_output=True, text=True, timeout=10
        )
        processes = json.loads(proc_result.stdout) if proc_result.returncode == 0 else []
        
        # Get network connections
        net_result = subprocess.run(
            ['powershell', 'Get-NetTCPConnection | Where-Object { $_.State -eq "Established" } | Select-Object LocalAddress, LocalPort, RemoteAddress, RemotePort, OwningProcess | ConvertTo-Json'],
            capture_output=True, text=True, timeout=10
        )
        connections = json.loads(net_result.stdout) if net_result.returncode == 0 else []
        
        # Flag suspicious
        suspicious_procs = []
        for proc in processes:
            name = proc.get('Name', '').lower()
            if any(susp in name for susp in SUSPICIOUS_PROCESSES):
                suspicious_procs.append(proc)
        
        suspicious_conns = []
        for conn in connections:
            if conn.get('RemotePort') in REMOTE_PORTS or conn.get('LocalPort') in REMOTE_PORTS:
                suspicious_conns.append(conn)
        
        return jsonify({
            'processes': processes[:50],  # Limit output
            'connections': connections[:20],
            'suspicious_processes': suspicious_procs,
            'suspicious_connections': suspicious_conns
        })
    except Exception as e:
        return jsonify({'error': str(e)}), 500

@app.route('/kill/<int:pid>', methods=['POST'])
def kill_process(pid):
    try:
        result = subprocess.run(
            ['powershell', f'Stop-Process -Id {pid} -Force'],
            capture_output=True, text=True, timeout=5
        )
        if result.returncode == 0:
            return jsonify({'status': f'Process {pid} killed'})
        else:
            return jsonify({'error': result.stderr}), 400
    except Exception as e:
        return jsonify({'error': str(e)}), 500

@app.route('/scan', methods=['POST'])
def scan_target():
    target = request.json.get('target')
    if not target:
        return jsonify({'error': 'Target required'}), 400
    
    try:
        # Simple ping scan
        result = subprocess.run(
            ['powershell', f'Test-Connection -ComputerName {target} -Count 1 | ConvertTo-Json'],
            capture_output=True, text=True, timeout=10
        )
        if result.returncode == 0:
            return jsonify({'scan_result': json.loads(result.stdout)})
        else:
            return jsonify({'error': 'Scan failed', 'details': result.stderr}), 400
    except Exception as e:
        return jsonify({'error': str(e)}), 500

