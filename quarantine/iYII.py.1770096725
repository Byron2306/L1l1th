<script>
async function sendMessage() {
    const input = document.getElementById('input').value.trim();
    if (!input) return;
    
    addMessage(input, 'user');
    document.getElementById('input').value = '';
    
    try {
        const response = await fetch('/chat', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({message: input})
        });
        
        const data = await response.json();
        
        if (data.error) {
            addMessage('ERROR: ' + data.error, 'lilith');
        } else {
            const msg = data.response + '\\n\\n[' + data.model + ' | ' + data.time + ']';
            addMessage(msg, 'lilith');
        }
    } catch (e) {
        addMessage('CONNECTION ERROR: ' + e, 'lilith');
    }
}

function addMessage(text, sender) {
    const history = document.getElementById('chatHistory');
    const msg = document.createElement('div');
    msg.className = 'message ' + sender;
    msg.innerHTML = text.replace(/\\n/g, '<br>');
    history.appendChild(msg);
    history.scrollTop = history.scrollHeight;
}

async function updateLilithConfig() {
    const config = {
        model: document.getElementById('model').value,
        personality: document.getElementById('personality').value,
        system_prompt: document.getElementById('systemprompt').value,
        active: document.getElementById('lilithEnabled').checked
    };
    
    try {
        await fetch('/config/lilith', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify(config)
        });
    } catch (e) {
        console.error('Config update failed:', e);
    }
}

async function updateGarakConfig() {
    const config = {
        probes: document.getElementById('garakProbes').value.split(',').map(p => p.trim()),
        enabled: document.getElementById('garakEnabled').checked
    };
    
    try {
        await fetch('/config/garak', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify(config)
        });
    } catch (e) {
        console.error('Config update failed:', e);
    }
}

async function updateClawbotConfig() {
    const config = {
        enabled: document.getElementById('clawbotEnabled').checked
    };
    
    try {
        await fetch('/config/clawbot', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify(config)
        });
    } catch (e) {
        console.error('Config update failed:', e);
    }
}

