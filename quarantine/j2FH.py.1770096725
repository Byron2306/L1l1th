    vuln_info = data.get('vulnerability', {})
    context = data.get('context')
    
    analysis = lilith.analyze_vulnerability(vuln_info, context)
    
    return jsonify({
        'analysis': analysis,
        'vulnerability': vuln_info
    })

@app.route('/generate_payload', methods=['POST'])
