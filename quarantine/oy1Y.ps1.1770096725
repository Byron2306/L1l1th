# PowerShell script to start Clawdbot AI ecosystem
# Start Clawdbot gateway
Start-Process -FilePath "C:\Users\User\.clawdbot\gateway.cmd" -WindowStyle Hidden

# Wait a bit for gateway to start
Start-Sleep -Seconds 10

# Start Garak (assuming it's installed)
Start-Process -FilePath "python" -ArgumentList "-m garak" -WindowStyle Hidden

# Start neural chat (assuming it's a module)
Start-Process -FilePath "python" -ArgumentList "-m neural_chat" -WindowStyle Hidden

Write-Output "Clawdbot, Garak, and neural chat started."