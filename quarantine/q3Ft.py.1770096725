                            <label>Kraken API Secret:</label>
                            <input type="password" name="kraken_api_secret" value="{api_keys.get('kraken_api_secret', '')}" placeholder="Enter your Kraken API secret">
                        </div>

                        <div class="form-group">
                            <label>Etherscan API Key:</label>
                            <input type="password" name="etherscan_api_key" value="{api_keys.get('etherscan_api_key', '')}" placeholder="Enter your Etherscan API key">
                        </div>
