                        </div>

                        <div class="form-group">
                            <label>Watch Address:</label>
                            <input type="text" name="watch_address" value="{api_keys.get('watch_address', '')}" placeholder="0xYourAddress">
                        </div>

                        <div class="form-group">
                            <label>ERC20 Token Address:</label>
                            <input type="text" name="erc20_token_address" value="{api_keys.get('erc20_token_address', '')}" placeholder="0xTokenAddress (optional)">
                        </div>
                    </div>

                    <div class="section">
                        <h3>🤖 Agent Configuration</h3>

                        <h4>Core Agents</h4>
                        <div class="checkbox-group">
                            <input type="checkbox" name="kill_switch_enabled" {"checked" if config.get('kill_switch_enabled') else ""}>
                            <label>Kill Switch Agent (Safety system)</label>
                        </div>

                        <div class="checkbox-group">
                            <input type="checkbox" name="ui_enabled" {"checked" if config.get('ui_enabled') else ""}>
                            <label>UI Agent (This dashboard)</label>
                        </div>

                        <h4>Optional Agents</h4>
                        <div class="checkbox-group">
                            <input type="checkbox" name="network_enabled" {"checked" if config.get('network_enabled') else ""}>
                            <label>Network Agent (Redis messaging)</label>
                        </div>

                        <div class="checkbox-group">
                            <input type="checkbox" name="data_store_enabled" {"checked" if config.get('data_store_enabled') else ""}>
                            <label>Data Store Agent (SQLite database)</label>
                        </div>

                        <div class="checkbox-group">
                            <input type="checkbox" name="performance_enabled" {"checked" if config.get('performance_enabled') else ""}>
                            <label>Performance Agent (System monitoring)</label>
                        </div>

                        <div class="checkbox-group">
                            <input type="checkbox" name="security_enabled" {"checked" if config.get('security_enabled') else ""}>
                            <label>Security Agent (Encryption)</label>
                        </div>

                        <h4>Connection Settings</h4>
                        <div class="form-group">
                            <label>UI Host:</label>
                            <input type="text" name="ui_host" value="{config.get('ui_host', '0.0.0.0')}">
                        </div>

                        <div class="form-group">
                            <label>UI Port:</label>
                            <input type="number" name="ui_port" value="{config.get('ui_port', 5000)}">
                        </div>

                        <div class="form-group">
                            <label>Allowed IPs (comma-separated, empty = allow all):</label>
                            <input type="text" name="allowed_ips" value="{','.join(config.get('allowed_ips', []) or [])}">
                        </div>

                        <div class="form-group">
