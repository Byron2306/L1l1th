from flask import Flask, request, jsonify, Response, stream_with_context
import time
import threading
import logging
import json
import yaml
import os
from datetime import datetime
from typing import List


class UIAgent:
    """
    User Interface Agent: Simple web dashboard for monitoring and configuring the swarm.
    """

    def __init__(self, coordinator, host: str = "0.0.0.0", port: int = 5000):
        self.coordinator = coordinator
        self.host = host
        self.port = port
        # Serve static files from the project-level `static/` directory
        project_root = os.path.abspath(os.path.join(os.path.dirname(__file__), '..'))
        static_folder = os.path.join(project_root, 'static')
        self.app = Flask(__name__, static_folder=static_folder, static_url_path='/static')
        self.config_path = "config/settings.yaml"
        self.api_keys_path = "config/api_keys.json"
        self.allowed_ips: List[str] = getattr(coordinator.cfg, "allowed_ips", []) or []
        # simple in-memory cache for costly endpoints to avoid flooding
        self._cache = {}
        self._setup_routes()
        self.thread = None

    def _setup_routes(self):
        @self.app.before_request
        def _ip_whitelist():
            if not self.allowed_ips:
                return  # allow all
            remote = request.remote_addr
            if remote in ("127.0.0.1", "::1"):
                return
            if remote not in self.allowed_ips:
                logging.warning(f"Blocked request from {remote}")
                return ("Forbidden", 403)

        @self.app.route("/")
        def dashboard():
            return self._render_dashboard()

        @self.app.route("/price.json")
        def price_json():
            # Rate-limited cache: price data updated at most once every 2s
            now = time.time()
            cache_ttl = 2.0
            cached = self._cache.get('price_json')
            if cached and now - cached['ts'] < cache_ttl:
                return jsonify(cached['value'])
            labels, prices = self._price_series()
            payload = {"labels": labels, "prices": prices}
            self._cache['price_json'] = {'ts': now, 'value': payload}
            return jsonify(payload)

        @self.app.route("/metrics.json")
        def metrics_json():
            # Metrics updated at most once every 3s to reduce pressure
            now = time.time()
            cache_ttl = 3.0
            cached = self._cache.get('metrics_json')
            if cached and now - cached['ts'] < cache_ttl:
                return jsonify(cached['value'])
            data = self._collect_metrics()
            self._cache['metrics_json'] = {'ts': now, 'value': data}
            return jsonify(data)

        @self.app.route("/tape.json")
        def tape_json():
            try:
                now = time.time()
                # Refresh tape once per minute to avoid UI flooding
                cache_ttl = 60.0
                cached = self._cache.get('tape_json')
                if cached and now - cached['ts'] < cache_ttl:
                    return jsonify(cached['value'])
                trades = self._get_market_tape(limit=10)
                # If no trades from agents, attempt direct CSV fallback to ensure UI can display tape
                if not trades:
                    try:
                        from pathlib import Path
                        import csv, os
                        # Resolve logs path relative to project root (one level above agents/)
                        path = Path(os.path.abspath(__file__)).resolve().parent.parent / 'logs' / 'trades.csv'
                        if path.exists():
                            with path.open('r', encoding='utf-8', errors='ignore') as f:
                                rows = list(csv.DictReader(f))
                                fb = []
                                for r in rows[-200:]:
                                    try:
                                        qty = float(r.get('quantity') or r.get('qty') or 0)
                                    except Exception:
                                        qty = 0.0
                                    try:
                                        price = float(r.get('price') or 0)
                                    except Exception:
                                        price = 0.0
                                    notional = qty * price
                                    fb.append({
                                        'timestamp': r.get('timestamp') or r.get('ts') or '',
                                        'symbol': r.get('symbol') or r.get('pair') or '',
                                        'side': r.get('side') or '',
                                        'quantity': qty,
                                        'price': price,
                                        'notional': notional,
                                        'order_id': r.get('order_id') or r.get('id') or None,
                                        'status': r.get('status') or 'tape',
                                        'venue': r.get('venue') or 'kraken',
                                    })
                                # sort by notional desc and keep top 100
                                trades = sorted(fb, key=lambda x: float(x.get('notional') or 0), reverse=True)[:100]
                    except Exception:
                        trades = []
                payload = {"trades": trades}
                self._cache['tape_json'] = {'ts': now, 'value': payload}
                return jsonify(payload)
            except Exception as e:
                logging.exception(f"tape.json handler error: {e}")
                return jsonify({'error': 'internal_server_error', 'details': str(e)}), 500

        @self.app.route("/trades")
        def trades():
            return self._render_trades()

        @self.app.route('/stream/trades')
        def stream_trades():
            try:
                return Response(stream_with_context(self._trades_event_stream()), mimetype='text/event-stream')
            except Exception as e:
                logging.error(f"Error creating trades stream: {e}")
                return ("", 500)

        @self.app.route('/stream/logs')
        def stream_logs():
            try:
                return Response(stream_with_context(self._logs_event_stream()), mimetype='text/event-stream')
            except Exception as e:
                logging.error(f"Error creating logs stream: {e}")
                return ("", 500)

        @self.app.route('/buzz/recent')
        def buzz_recent():
            """Return recent 'buzz' messages (schema-based). If agents expose data use it, otherwise synthesize lightweight messages."""
            try:
                agents = list(self.coordinator.agents.keys()) if self.coordinator and getattr(self.coordinator, 'agents', None) else []
                msgs = []
                ts = int(time.time() * 1000)
                latest_price = None
                try:
                    latest_price = float(self.coordinator.get_shared_data('latest_price') or 0)
                except Exception:
                    latest_price = None
                for a in agents:
                    at = a.lower()
                    if at in ('market_data', 'market'):
                        msgs.append({
                            'buzz': {'type': 'buzz.market.data', 'source': 'MARKET_DATA'},
                            'payload': {
                                'venue': getattr(self.coordinator.cfg, 'exchange', 'unknown'),
                                'symbol': getattr(self.coordinator.cfg, 'symbol', 'UNKNOWN'),
                                'price': latest_price or 0,
                                'ohlcv': {'tf': getattr(self.coordinator.cfg, 'interval', '1m'), 'o': 0, 'h': 0, 'l': 0, 'c': latest_price or 0, 'v': 0},
                                'spread_pct': 0.0,
                                'ts': ts
                            }
                        })
                    elif at in ('wallet', 'wallet_monitor', 'wallet_monitor_agent'):
                        snap = self._get_wallet_snapshot() or {}
                        balances = []
                        for k, v in snap.items():
                            try:
                                balances.append({'asset': k, 'free': float(v), 'locked': 0.0})
                            except Exception:
                                balances.append({'asset': k, 'free': 0.0, 'locked': 0.0})
                        msgs.append({'buzz': {'type': 'buzz.wallet.balance', 'source': 'WALLET_MONITOR'}, 'payload': {'wallet_type': 'WATCH', 'venue': getattr(self.coordinator.cfg, 'exchange', 'unknown'), 'balances': balances, 'equity_usd': sum([b.get('free',0)* (latest_price or 0) for b in balances])}})
                    elif at in ('strategy',):
                        msgs.append({'buzz': {'type': 'buzz.strategy.signal', 'source': 'STRATEGY'}, 'payload': {'strategy': getattr(self.coordinator.cfg, 'strategy_type', 'sma_crossover'), 'symbol': getattr(self.coordinator.cfg, 'symbol', 'UNKNOWN'), 'action': 'HOLD', 'confidence': 0.5, 'position_size_pct': 0.01, 'stop_loss': None, 'take_profit': None, 'notes': 'periodic heartbeat', 'ts': ts}})
                    elif at in ('execution',):
                        msgs.append({'buzz': {'type': 'buzz.trade.execution', 'source': 'EXECUTION'}, 'payload': {'symbol': getattr(self.coordinator.cfg, 'symbol', 'UNKNOWN'), 'side': 'BUY', 'status': 'SIMULATED', 'filled_qty': 0.0, 'avg_price': latest_price or 0, 'fees': 0.0, 'slippage_pct': 0.0, 'order_id': None, 'ts': ts}})
                    elif at in ('logging',):
                        msgs.append({'buzz': {'type': 'buzz.trade.log', 'source': 'LOGGING'}, 'payload': {'trade_id': f'trade-{ts}', 'strategy': getattr(self.coordinator.cfg, 'strategy_type', 'sma_crossover'), 'symbol': getattr(self.coordinator.cfg, 'symbol', 'UNKNOWN'), 'entry_price': latest_price or 0, 'exit_price': None, 'status': 'OPEN', 'ts': ts}})
                    elif at in ('performance',):
                        msgs.append({'buzz': {'type': 'buzz.performance.snapshot', 'source': 'PERFORMANCE'}, 'payload': {'equity_usd': 0.0, 'pnl_24h': 0.0, 'drawdown_pct': 0.0, 'win_rate': 0.0, 'ts': ts}})
                    elif at in ('kill_switch',):
                        msgs.append({'buzz': {'type': 'buzz.kill.check', 'source': 'KILL_SWITCH'}, 'payload': {'risk_state': 'OK', 'daily_loss_pct': 0.0, 'max_allowed_pct': getattr(self.coordinator.cfg, 'max_drawdown_pct', 5.0), 'ts': ts}})
                    elif at in ('security',):
                        msgs.append({'buzz': {'type': 'buzz.security.event', 'source': 'SECURITY'}, 'payload': {'event': 'HEALTH_CHECK', 'status': 'OK', 'notes': 'heartbeat', 'ts': ts}})
                    else:
                        msgs.append({'buzz': {'type': 'buzz.system.command', 'source': 'UI'}, 'payload': {'command': 'NOOP', 'scope': 'LOCAL', 'ts': ts}})
                return jsonify({'messages': msgs})
            except Exception as e:
                logging.exception(f"buzz_recent error: {e}")
                return jsonify({'error': str(e)}), 500

        @self.app.route("/wallet")
        def wallet():
            return self._render_wallet()

        @self.app.route("/wallet/address")
        def wallet_address():
            try:
                wallet = self.coordinator.agents.get('wallet')
                if not wallet:
                    return jsonify({'error': 'wallet_not_configured'}), 404
                addr = getattr(wallet, 'addr', None) or getattr(wallet, 'address', None)
                return jsonify({'address': addr})
            except Exception as e:
                logging.exception(f"wallet_address error: {e}")
                return jsonify({'error': 'internal', 'details': str(e)}), 500

        @self.app.route("/wallet/buy", methods=["POST"])
        def wallet_buy():
            try:
                quote_amount = float(request.form.get('quote_amount') or request.json.get('quote_amount') or 0)
            except Exception:
                return jsonify({'error': 'invalid_amount'}), 400
            exec_agent = self.coordinator.agents.get('execution')
            if not exec_agent:
                return jsonify({'error': 'execution_agent_unavailable'}), 503
            try:
                # attempt market buy using quote amount (exchange adapter handles dry_run)
                res = None
                if hasattr(exec_agent, 'buy_market_quote'):
                    res = exec_agent.buy_market_quote(quote_amount)
                else:
                    return jsonify({'error': 'execution_agent_cannot_buy'}), 500
                return jsonify({'result': res}), 200
            except Exception as e:
                logging.exception(f"wallet_buy error: {e}")
                return jsonify({'error': 'internal', 'details': str(e)}), 500

        @self.app.route("/logs")
        def logs():
            return self._render_logs()

        @self.app.route("/config", methods=["GET", "POST"])
        def config():
            try:
                if request.method == "POST":
                    return self._save_config()
                return self._render_config()
            except Exception as e:
                logging.exception(f"Config page error: {e}")
                return ("Internal Server Error while rendering config. Check server logs.", 500)

        @self.app.route("/enable_network", methods=["POST"])
        def enable_network():
            # Read form values and attempt to enable Network (Redis) via coordinator
            try:
                host = request.form.get('redis_host') or request.form.get('host')
                port = int(request.form.get('redis_port') or request.form.get('port') or 6379)
                db = int(request.form.get('redis_db') or request.form.get('db') or 0)
                password = request.form.get('redis_password') or None

                success = False
                try:
                    success = self.coordinator.enable_network(host=host, port=port, db=db, password=password)
                except Exception as e:
                    logging.warning(f"Error enabling network from UI: {e}")

                if success:
                    msg = f"✅ Connected to Redis at {host}:{port}"
                else:
                    msg = f"❌ Could not connect to Redis at {host}:{port}. Check settings and try again."

                return f"""
                <!DOCTYPE html>
                <html>
                <head><title>Redis Connection</title></head>
                <body style='font-family: Arial, sans-serif; text-align: center; margin: 50px;'>
                    <h2>{msg}</h2>
                    <a href="/config">Back to Configuration</a>
                    <a href="/">Back to Dashboard</a>
                </body>
                </html>
                """
            except Exception as e:
                logging.error(f"Enable network handler error: {e}")
                return ("Error enabling network", 500)

        @self.app.route("/debug/tape_status")
        def debug_tape_status():
            """Return debug information about tape sources: CSV file path, existence, counts, and in-memory sizes."""
            try:
                from pathlib import Path
                import os, csv, sqlite3, time

                info = {}
                # resolve CSV path relative to project root
                csv_path = Path(os.path.abspath(__file__)).resolve().parent.parent / 'logs' / 'trades.csv'
                info['csv_path'] = str(csv_path)
                info['csv_exists'] = csv_path.exists()
                if csv_path.exists():
                    st = csv_path.stat()
                    info['csv_size_bytes'] = st.st_size
                    info['csv_mtime'] = time.ctime(st.st_mtime)
                    # count rows (best-effort)
                    try:
                        with csv_path.open('r', encoding='utf-8', errors='ignore') as f:
                            reader = csv.reader(f)
                            rows = sum(1 for _ in reader)
                            # subtract header if present
                            info['csv_rows'] = max(0, rows - 1)
                    except Exception:
                        info['csv_rows'] = None

                # in-memory logging buffer size
                try:
                    log_agent = self.coordinator.agents.get('logging')
                    info['logging_in_memory'] = len(getattr(log_agent, 'trades', [])) if log_agent else None
                except Exception:
                    info['logging_in_memory'] = None

                # data_store trades count (best-effort)
                try:
                    ds = self.coordinator.agents.get('data_store')
                    if ds and getattr(ds, 'db_path', None):
                        conn = sqlite3.connect(ds.db_path)
                        cur = conn.cursor()
                        cur.execute("SELECT COUNT(*) FROM trades")
                        info['data_store_trades'] = cur.fetchone()[0]
                        conn.close()
                    else:
                        info['data_store_trades'] = None
                except Exception:
                    info['data_store_trades'] = None

                # cached tape_json status
                try:
                    cached = self._cache.get('tape_json')
                    if cached:
                        info['tape_json_cached'] = True
                        info['tape_json_cached_ts'] = cached.get('ts')
                    else:
                        info['tape_json_cached'] = False
                except Exception:
                    info['tape_json_cached'] = None

                return jsonify(info)
            except Exception as e:
                logging.exception(f"Debug tape status error: {e}")
                return jsonify({'error': str(e)}), 500

    def _render_dashboard(self):
        """Render a modern dashboard with live metrics, trades, price, wallet, and logs."""
        agents = list(self.coordinator.agents.keys()) if self.coordinator.agents else []

        perf_metrics = {}
        if self.coordinator.agents.get("performance"):
            try:
                perf_metrics = self.coordinator.agents["performance"].get_current_metrics()
            except Exception:
                perf_metrics = {}

        trade_metrics = {}
        if self.coordinator.agents.get("logging"):
            try:
                trade_metrics = self.coordinator.agents["logging"].get_metrics()
            except Exception:
                trade_metrics = {}

        recent_trades = self._get_recent_trades(limit=15)
        wallet_snapshot = self._get_wallet_snapshot()
        logs = self._get_logs(limit=40)

        agent_health = {}
        if self.coordinator.agents.get("performance"):
            try:
                agent_health = self.coordinator.agents["performance"].get_agent_health()
            except Exception:
                agent_health = {}
        if not agent_health:
            agent_health = getattr(self.coordinator, "agent_health", {}) or {}

        def status_color(name: str) -> str:
            val = agent_health.get(name, {})
            status = val.get("status") if isinstance(val, dict) else val
            if status is None:
                return "red"
            return "green" if str(status).lower() in ("active", "ok", "initialized", "ready") else "red"

        try:
            latest_price = self.coordinator.get_shared_data("latest_price")
        except Exception:
            latest_price = None

        win_rate_display = f"{trade_metrics.get('win_rate', 0):.0%}" if trade_metrics else "N/A"
        cpu_val = perf_metrics.get("cpu_percent", "N/A")
        mem_val = perf_metrics.get("memory_percent", "N/A")
        pnl_val = trade_metrics.get("profit_loss", "0")
        latest_price_str = f"{latest_price:.2f}" if isinstance(latest_price, (int, float)) else (latest_price or "N/A")

        agent_pills = "".join(
            f'<div class="pill"><span class="status-dot {status_color(a)}"></span>{a}</div>'
            for a in agents
        ) or '<div class="empty">No agents registered</div>'

        # Market tape trades (show top-N by notional to avoid flooding the UI)
        tape_trades = self._get_market_tape(limit=50)
        trade_rows = "".join(
            f"<tr><td>{t.get('timestamp','')}</td><td>{t.get('symbol','')}</td><td>{t.get('side','')}</td>"
            f"<td>{t.get('quantity','')}</td><td>{t.get('price','')}</td><td>{t.get('notional', '')}</td><td>{t.get('sentiment','')}</td><td>{t.get('venue','kraken')}</td></tr>"
            for t in tape_trades
        ) or '<tr><td colspan="8" class="empty">No trades captured yet</td></tr>'

        if wallet_snapshot:
            wallet_rows = "<table><tbody>" + "".join(
                f"<tr><td>{k}</td><td>{v}</td></tr>" for k, v in wallet_snapshot.items()
            ) + "</tbody></table>"
        else:
            wallet_rows = '<div class="empty">No wallet data</div>'

        log_lines = [
            f"[{entry.get('timestamp','')}] {entry.get('agent','')}: {entry.get('message','')}" if isinstance(entry, dict) else str(entry)
            for entry in logs
        ]
        log_tail = "\n".join(log_lines)

        agent_latest_log = {}
        for entry in logs:
            agent_name = entry.get("agent") if isinstance(entry, dict) else None
            if agent_name and agent_name not in agent_latest_log:
                agent_latest_log[agent_name] = entry.get("message", "")

        agent_log_blocks = "".join(
            f'<div class="agent-log"><div class="pill"><span class="status-dot {status_color(a)}"></span>{a}</div>'
            f'<div class="small-log">{agent_latest_log.get(a, "No recent logs")}</div></div>'
            for a in agents
        ) or '<div class="empty">No agent logs</div>'

        html = """
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Crypto Swarm Dashboard</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
        :root {
            /* Dark blue background and yellow text to match Hivenance branding */
            --bg: #071026; /* deep navy */
            --panel: #0d1730;
            --accent: #ffd24a; /* primary yellow */
            --accent-2: #ffdf7a;
            --text: #ffd24a; /* yellow text */
            --muted: #d9c786; /* muted yellow/gold */
            --danger: #ff6b6b;
        }
    * { box-sizing: border-box; }
    body {
      margin: 0; padding: 22px;
      font-family: 'Segoe UI', 'Inter', sans-serif;
      background: radial-gradient(circle at 20% 20%, rgba(127,209,255,0.08), transparent 30%), var(--bg);
      color: var(--text);
    }
    .wrap { max-width: 1200px; margin: 0 auto; }
    .top {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 18px;
    }
    .badge { padding: 6px 10px; border-radius: 999px; background: rgba(127,209,255,0.1); color: var(--accent); font-size: 12px; letter-spacing: .5px; }
    h1 { margin: 0; font-size: 26px; letter-spacing: .3px; }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(230px,1fr));
      gap: 14px;
      margin-bottom: 16px;
    }
    .card {
      background: linear-gradient(145deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 12px;
      padding: 14px;
      box-shadow: 0 12px 40px rgba(0,0,0,0.35);
    }
    .card h3 {
      margin: 0 0 6px;
      font-size: 14px; color: var(--muted); letter-spacing: .3px;
    }
    .value { font-size: 24px; font-weight: 600; color: var(--accent); }
    .value.small { font-size: 16px; color: var(--text); }
    .pill {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 8px 10px; margin: 4px 6px 4px 0;
      border-radius: 8px; background: rgba(255,255,255,0.04); color: var(--text);
      border: 1px solid rgba(255,255,255,0.05);
      font-size: 13px;
    }
    .pill span { color: var(--muted); font-size: 12px; }
    .status-dot { width: 9px; height: 9px; border-radius: 50%; display: inline-block; }
    .status-dot.green { background: #3ad29f; box-shadow: 0 0 6px rgba(58,210,159,0.8); }
    .status-dot.red { background: #ff6b6b; box-shadow: 0 0 6px rgba(255,107,107,0.8); }
    table { width: 100%; border-collapse: collapse; margin-top: 8px; }
    th, td { padding: 8px 10px; font-size: 13px; text-align: left; }
    th { color: var(--muted); border-bottom: 1px solid rgba(255,255,255,0.08); }
    tr:not(:last-child) td { border-bottom: 1px solid rgba(255,255,255,0.04); }
    .row { display: grid; gap: 14px; grid-template-columns: 2fr 1fr; }
    @media(max-width: 960px) { .row { grid-template-columns: 1fr; } }
    .chart-wrap { height: 260px; }
    .empty { color: var(--muted); font-style: italic; padding: 8px 0; }
    .toolbar a { color: var(--accent); text-decoration: none; margin-right: 14px; font-size: 13px; }
    .log-tail {
      background: rgba(0,0,0,0.35); border: 1px solid rgba(255,255,255,0.06);
      padding: 10px; border-radius: 10px; max-height: 200px; overflow-y: auto;
      font-family: 'JetBrains Mono', 'Consolas', monospace; font-size: 12px; white-space: pre-wrap;
    }
    .agent-log { margin-bottom: 10px; }
    .small-log { margin-left: 4px; color: var(--muted); font-size: 12px; }
    /* Agents / Buzz feed styles */
    .agents-container { display:flex; gap:16px; align-items:flex-start; }
    .agents-list { background: rgba(255,255,255,0.015); border:1px solid rgba(255,255,255,0.03); padding:8px; border-radius:8px; }
    .agent-item { display:flex; align-items:center; gap:10px; padding:6px 8px; border-radius:6px; margin-bottom:6px; }
    .agent-dot { width:12px; height:12px; border-radius:50%; display:inline-block; }
    .agent-dot.green { background: #3ad29f; box-shadow: 0 0 6px rgba(58,210,159,0.6); }
    .agent-dot.red { background: #ff6b6b; box-shadow: 0 0 6px rgba(255,107,107,0.6); }
    .agent-name { color: var(--accent); font-weight:600; }
    .agent-buzz-item { padding:8px; border-radius:8px; background: linear-gradient(90deg, rgba(255,210,74,0.02), rgba(255,210,74,0.01)); margin-bottom:8px; border:1px solid rgba(255,210,74,0.03); }
  </style>
</head>
<body>
    <!-- Top-centered logo (place the attached image at /static/hivenance_logo.png) -->
    <div style="display:flex; justify-content:center; margin: 8px 0 12px 0;">
        <img id="siteLogo" src="/static/hivenance_logo.png" alt="Hivenance" style="max-width:220px; max-height:160px; width:auto; height:auto; object-fit:contain; display:block;"/>
    </div>

    <div class="wrap">
    <div class="top">
      <div>
        <h1>Crypto Swarm Control</h1>
        <div class="badge">LIVE • __AGENT_COUNT__ agents</div>
      </div>
      <div class="toolbar" style="opacity:0.7;">Live Trades Feed</div>
    </div>

    <div class="grid">
      <div class="card"><h3>Active Agents</h3><div class="value" id="activeAgents">__AGENT_COUNT__</div></div>
      <div class="card"><h3>Latest Price</h3><div class="value" id="latestPrice">__LATEST_PRICE__</div></div>
      <div class="card"><h3>PnL (agg)</h3><div class="value" id="pnlAgg">__PNL__</div></div>
      <div class="card"><h3>Win Rate</h3><div class="value" id="winRate">__WIN_RATE__</div></div>
      <div class="card"><h3>CPU</h3><div class="value small" id="cpuUsage">__CPU__</div></div>
      <div class="card"><h3>Memory</h3><div class="value small" id="memUsage">__MEM__</div></div>
    </div>

        <div class="row">
            <div class="card">
                <h3>Market Price (live)</h3>
                <div class="chart-wrap"><canvas id="priceChart"></canvas></div>
            </div>
            <div class="card">
                <h3>Agents</h3>
                <div>__AGENT_PILLS__</div>
            </div>
        </div>

    <div class="row" style="margin-top:14px;">
      <div class="card">
        <h3>Recent Trades</h3>
                <table>
                    <thead><tr><th>Time</th><th>Pair</th><th>Side</th><th>Qty</th><th>Price</th><th>Notional</th><th>Sentiment</th><th>Venue</th></tr></thead>
                    <tbody id="recentTradesBody">__TRADE_ROWS__</tbody>
                </table>
      </div>
      <div class="card">
        <h3>Wallet</h3>
        __WALLET_ROWS__
      </div>
    </div>

        <!-- Agents list and periodic reporting (left: agent names + status; right: latest buzz messages) -->
        <div class="row" style="margin-top:10px;">
            <div class="card" style="padding:10px;">
                <div class="agents-container" style="display:flex; gap:16px;">
                    <div class="agents-list" id="agentsList" style="min-width:240px;">
                        <!-- agent items inserted here -->
                    </div>
                    <div class="agents-buzz" id="agentsBuzz" style="flex:1;">
                        <!-- per-agent buzz messages rendered here -->
                    </div>
                </div>
            </div>
        </div>

    <div class="row" style="margin-top:14px;">
      <div class="card">
        <h3>Live Logs</h3>
        <pre class="log-tail">__LOG_TAIL__</pre>
      </div>
      <div class="card">
        <h3>Agent Logs</h3>
        __AGENT_LOGS__
      </div>
    </div>
  </div>

  <script>
    const priceCtx = document.getElementById('priceChart').getContext('2d');
    let priceChart;
    const cb = () => 'v=' + Date.now();
    async function loadTrades() {
      try {
                const res = await fetch('/tape.json?' + cb());
                const data = await res.json();
                // server returns top-N by notional already
                const trades = data.trades || [];
        const tbody = document.getElementById('recentTradesBody');
        if (!tbody) return;
                tbody.innerHTML = trades.length ? trades.map(t => `
                    <tr>
                        <td>${t.timestamp || ''}</td>
                        <td>${t.symbol || ''}</td>
                        <td>${t.side || ''}</td>
                        <td>${t.quantity || ''}</td>
                        <td>${t.price || ''}</td>
                        <td>${t.notional !== undefined ? Number(t.notional).toFixed(2) : ''}</td>
                        <td>${t.sentiment !== undefined && t.sentiment !== null ? t.sentiment.toFixed(2) : ''}</td>
                        <td>${t.venue || ''}</td>
                    </tr>`).join('') : '<tr><td colspan="8" class="empty">No trades captured yet</td></tr>';
      } catch (err) {
        console.error('trades load failed', err);
      }
    }

    async function loadPrice() {
      try {
        const canvas = document.getElementById('priceChart');
        if (!canvas) return;
        const res = await fetch('/price.json?' + cb());
        const data = await res.json();
        const labels = Array.isArray(data.labels) ? data.labels : [];
        const prices = Array.isArray(data.prices) ? data.prices : [];
        const latest = prices.length ? prices[prices.length - 1] : null;
        document.getElementById('latestPrice').innerText = latest !== null ? Number(latest).toFixed(2) : 'N/A';

        // Ensure chart exists before updating
        if (!priceChart) {
          priceChart = new Chart(priceCtx, {
            type: 'line',
            data: {
              labels: labels,
                                datasets: [{
                                label: 'Price',
                                data: prices,
                                borderColor: '#ffd24a',
                                backgroundColor: 'rgba(255,210,74,0.12)',
                                tension: 0.25,
                                pointRadius: 0
                            }]
            },
            options: {
              responsive: true,
              animation: false,
              plugins: { legend: { display: false } },
              scales: {
                x: { ticks: { color: '#9fb0d8' }, grid: { color: 'rgba(255,255,255,0.05)' } },
                y: { ticks: { color: '#9fb0d8' }, grid: { color: 'rgba(255,255,255,0.05)' } }
              }
            }
          });
          return;
        }

        // Update existing chart
        priceChart.data.labels = labels;
        priceChart.data.datasets[0].data = prices;
        priceChart.update();
      } catch (err) {
        console.error('price load failed', err);
      }
    }

    async function loadMetrics() {
      try {
        const res = await fetch('/metrics.json?' + cb());
        const data = await res.json();
        const perf = data.performance || {};
        const trading = data.trading || {};
        document.getElementById('activeAgents').innerText = data.agents ? data.agents.length : document.getElementById('activeAgents').innerText;
        document.getElementById('cpuUsage').innerText = perf.cpu_percent ?? document.getElementById('cpuUsage').innerText;
        document.getElementById('memUsage').innerText = perf.memory_percent ?? document.getElementById('memUsage').innerText;
        document.getElementById('pnlAgg').innerText = trading.profit_loss ?? document.getElementById('pnlAgg').innerText;
        document.getElementById('winRate').innerText = (trading.win_rate !== undefined) ? Math.round(trading.win_rate * 100) + '%' : document.getElementById('winRate').innerText;
      } catch (err) {
        console.error('metrics load failed', err);
      }
    }

    function startTradeStream() {
            if (!window.EventSource) return;
            const es = new EventSource('/stream/trades');
            // Throttle inserts: at most one DOM insert every `minInsertMs` ms
            let lastInsertTs = 0;
            const minInsertMs = 2000; // 2 seconds
            es.onmessage = (e) => {
                try {
                    const t = JSON.parse(e.data);
                    // Compute notional if missing
                    const qty = Number(t.quantity || t.qty || 0);
                    const price = Number(t.price || 0);
                    const notional = Number(t.notional || (qty * price) || 0);
                    const side = (t.side || '').toUpperCase();
                    // Only show large SELL prints to avoid flooding
                    if (side !== 'SELL' || notional < 2000) return;
                    if (Date.now() - lastInsertTs < minInsertMs) return;
                    lastInsertTs = Date.now();

                    const tbody = document.getElementById('recentTradesBody');
                    if (!tbody) return;
                    const row = document.createElement('tr');
                    const fields = [t.timestamp || '', t.symbol || t.pair || '', t.side || '', t.quantity || t.qty || '', t.price || '', notional !== undefined ? Number(notional).toFixed(2) : '', t.sentiment !== undefined && t.sentiment !== null ? (Number(t.sentiment).toFixed(2)) : '', t.venue || ''];
                    for (let i = 0; i < fields.length; i++) {
                            const td = document.createElement('td');
                            td.innerText = fields[i];
                            row.appendChild(td);
                    }
                    if (tbody.firstChild) tbody.insertBefore(row, tbody.firstChild);
                    else tbody.appendChild(row);
                    // keep only top 10 rows in UI
                    while (tbody.rows.length > 10) tbody.deleteRow(10);
                } catch (err) { console.error('SSE trade parse', err); }
            };
            es.onerror = (e) => console.warn('SSE error', e);
    }

        loadPrice(); loadMetrics(); loadTrades();
        // Start SSE stream but throttle DOM updates to avoid client overload
        startTradeStream();
        // Poll once per minute to refresh aggregated tape view
        setInterval(() => { loadPrice(); loadMetrics(); loadTrades(); }, 60000);
  </script>
</body>
</html>
"""
        html = html.replace("__AGENT_COUNT__", str(len(agents)))
        html = html.replace("__LATEST_PRICE__", str(latest_price_str))
        html = html.replace("__PNL__", str(pnl_val))
        html = html.replace("__WIN_RATE__", str(win_rate_display))
        html = html.replace("__CPU__", str(cpu_val))
        html = html.replace("__MEM__", str(mem_val))
        html = html.replace("__AGENT_PILLS__", agent_pills)
        html = html.replace("__TRADE_ROWS__", trade_rows)
        html = html.replace("__WALLET_ROWS__", wallet_rows)
        html = html.replace("__LOG_TAIL__", log_tail)
        html = html.replace("__AGENT_LOGS__", agent_log_blocks)
        # ensure any stray placeholder remnants removed
        html = html.replace("LS__", "")
        return html

        html = f"""
        <!DOCTYPE html>
        <html>
        <head>
