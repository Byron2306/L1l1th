                            <select name="interval">
                                <option value="1m" {"selected" if config.get('interval') == '1m' else ""}>1 Minute</option>
                                <option value="5m" {"selected" if config.get('interval') == '5m' else ""}>5 Minutes</option>
                                <option value="15m" {"selected" if config.get('interval') == '15m' else ""}>15 Minutes</option>
