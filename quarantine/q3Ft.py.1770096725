                    <button type="submit" class="nav-button save-button">💾 Save Configuration</button>
                </form>
            </div>
        </body>
        </html>
        """
        return html

    def _get_logs(self, limit: int = 40):
        """Fetch recent logs from data store or fallback file."""
        logs = []
        if self.coordinator.agents.get("data_store"):
            try:
                raw = self.coordinator.agents["data_store"].get_logs(limit=limit)
                for row in raw:
                    if isinstance(row, dict):
                        logs.append(dict(row))
                    elif hasattr(row, "keys"):
                        logs.append({k: row[k] for k in row.keys()})
                    elif isinstance(row, (list, tuple)) and len(row) >= 4:
                        logs.append({"timestamp": row[0], "level": row[1], "message": row[2], "agent": row[3]})
            except Exception:
                logs = []
        if not logs:
            try:
                from pathlib import Path
                # Prefer the rolling activity log for Live Logs display.
                # Do not show the generated trading report (report.txt) in the Live Logs
                # as it contains summary text that should not populate the live log tail.
                path = Path("logs/activity.log")
                if path.exists():
                    lines = path.read_text(encoding="utf-8", errors="ignore").splitlines()[-limit:]
                    logs = [{"timestamp": "", "level": "INFO", "message": line, "agent": "file"} for line in lines]
            except Exception:
                pass
        return logs

    def _get_recent_trades(self, limit: int = 20):
        trades = []
        try:
            if self.coordinator.agents.get("logging"):
                trades = self.coordinator.agents["logging"].get_recent_trades(limit)
            elif self.coordinator.agents.get("data_store"):
                trades = self.coordinator.agents["data_store"].get_recent_trades(limit)
        except Exception:
            trades = []

        # Normalize tuple rows from SQLite to dicts
        normalized = []
        for t in trades or []:
            if isinstance(t, dict):
                normalized.append(t)
            elif isinstance(t, (list, tuple)):
                # SQLite rows from DataStoreAgent are tuples. Schema is:
                # (id, timestamp, symbol, side, quantity, price, status)
                if len(t) >= 7:
                    normalized.append({
                        "id": t[0],
                        "timestamp": t[1],
                        "symbol": t[2],
                        "side": t[3],
                        "quantity": t[4],
                        "price": t[5],
                        "order_id": None,
                        "status": t[6],
                    })
                else:
                    # best-effort fallback for other tuple shapes
                    try:
                        normalized.append({
                            "id": t[0],
                            "timestamp": t[1] if len(t) > 1 else "",
                            "symbol": t[2] if len(t) > 2 else "",
                            "side": t[3] if len(t) > 3 else "",
                            "quantity": t[4] if len(t) > 4 else "",
                            "price": t[5] if len(t) > 5 else "",
                            "order_id": None,
                            "status": t[6] if len(t) > 6 else "",
                        })
                    except Exception:
                        normalized.append({"raw": t})
            else:
                # fallback best-effort
                normalized.append({"raw": t})
        if normalized:
            return normalized

        # Fallback: if nothing found from agents, try reading the CSV trade log directly
        try:
            from pathlib import Path
            import csv
            path = Path('logs') / 'trades.csv'
            if path.exists():
                with path.open('r', encoding='utf-8', errors='ignore') as f:
                    reader = list(csv.DictReader(f))
                    # take last `limit` rows
                    rows = reader[-limit:]
                    fb = []
                    for r in reversed(rows):
                        try:
                            qty = float(r.get('quantity') or r.get('qty') or 0)
                        except Exception:
                            qty = 0.0
                        try:
                            price = float(r.get('price') or 0)
                        except Exception:
                            price = 0.0
                        notional = qty * price
                        fb.append({
                            'timestamp': r.get('timestamp') or r.get('ts') or '',
                            'symbol': r.get('symbol') or r.get('pair') or '',
                            'side': r.get('side') or '',
                            'quantity': qty,
                            'price': price,
                            'notional': notional,
                            'order_id': r.get('order_id') or r.get('id') or None,
                            'status': r.get('status') or 'tape',
                            'venue': r.get('venue') or 'kraken',
                        })
                    return fb
        except Exception:
            pass

        return []

    def _get_market_tape(self, limit: int = 50):
        """Return recent market trades for dashboard.
        Return the top `limit` trades sorted by notional (impact) so the
        UI surfaces the biggest prints and avoids flooding with low-impact
        events.
        """
        # Get a larger recent set and select top SELL prints by notional.
        trades = self._get_recent_trades(limit=200) or []

        def compute_notional(t):
            try:
                n = t.get('notional')
                if n is None:
                    qty = float(t.get('quantity') or 0)
                    price = float(t.get('price') or 0)
                    return qty * price
                return float(n)
            except Exception:
                return 0.0

        # Filter for SELL trades with meaningful notional (>= 2000)
        candidates = []
        for t in trades:
            try:
                side = (t.get('side') or '').upper()
                notional = compute_notional(t)
                if side == 'SELL' and notional >= 2000.0:
                    t['notional'] = notional
                    candidates.append(t)
            except Exception:
                continue

        sorted_trades = sorted(candidates, key=lambda x: float(x.get('notional') or 0), reverse=True)
        return sorted_trades[:limit]

    def _trades_event_stream(self, poll_interval: float = 3.0):
        """Generator that yields Server-Sent Events for new trades.
        It polls the logging or data_store agent for recent trades and streams
        any trades that haven't been seen yet.
        """
        seen = set()
        try:
            while True:
                try:
                    trades = self._get_recent_trades(limit=50)
                except Exception:
                    trades = []

                # pick top candidates by notional to avoid flooding the SSE
                try:
                    cand = sorted(trades or [], key=lambda x: float(x.get('notional') or 0), reverse=True)[:50]
                except Exception:
                    cand = list(trades or [])

                # send oldest-first among the selected top candidates
                for t in reversed(cand):
                    try:
                        key = (str(t.get('timestamp')), str(t.get('symbol')), str(t.get('side')), str(t.get('quantity')), str(t.get('price')))
                        if key in seen:
                            continue
                        seen.add(key)
                        payload = json.dumps(t)
                        yield f"data: {payload}\n\n"
                    except GeneratorExit:
                        raise
                    except Exception:
                        continue

                time.sleep(poll_interval)
        except GeneratorExit:
            # client disconnected
            return
        except Exception as e:
            logging.error(f"Trades SSE generator error: {e}")
            return

    def _logs_event_stream(self, poll_interval: float = 2.0):
        """Generator yielding Server-Sent Events for recent logs.
        Polls the logging agent for recent logs and streams unseen entries.
        Each log from `get_recent_logs` is expected to be tuple: (id?, ts, level, msg, agent)
        """
        seen = set()
        try:
            while True:
                try:
                    logs = []
                    if self.coordinator.agents.get('logging'):
                        try:
                            logs = self.coordinator.agents['logging'].get_recent_logs(200)
                        except Exception:
                            logs = []
                    # send newest-first as they appear; iterate reversed to stream oldest new first
                    for entry in reversed(logs):
                        try:
                            # entry may be (id, ts, level, msg, agent) or (ts, level, msg, agent)
                            if len(entry) == 5:
                                _, ts, level, msg, agent = entry
                            elif len(entry) == 4:
                                ts, level, msg, agent = entry
                            else:
                                # best-effort unpack
                                ts = entry[1] if len(entry) > 1 else ''
                                level = entry[2] if len(entry) > 2 else ''
                                msg = entry[3] if len(entry) > 3 else str(entry)
                                agent = entry[4] if len(entry) > 4 else ''

                            key = (str(ts), str(level), str(agent), str(msg))
                            if key in seen:
                                continue
                            seen.add(key)
                            payload = json.dumps({'ts': ts, 'level': level, 'agent': agent, 'msg': msg})
                            yield f"data: {payload}\n\n"
                        except GeneratorExit:
                            raise
                        except Exception:
                            continue
                except Exception:
                    pass

                time.sleep(poll_interval)
        except GeneratorExit:
            return
        except Exception as e:
            logging.error(f"Logs SSE generator error: {e}")
            return

    def _get_wallet_snapshot(self):
        wallet = self.coordinator.agents.get("wallet")
        if not wallet:
            return {}
        snapshot = {}
        try:
            snapshot["ETH"] = f"{wallet.eth_balance():.4f}"
            tok = wallet.erc20_balance()
            if tok is not None:
                snapshot[wallet.token_symbol or 'TOKEN'] = f"{tok:.4f}"
        except Exception:
            return {}
        return snapshot

    def _collect_metrics(self):
        data = {"performance": {}, "trading": {}, "agents": list(self.coordinator.agents.keys())}
        perf = self.coordinator.agents.get("performance")
        if perf:
            try:
                data["performance"] = perf.get_current_metrics()
            except Exception:
                data["performance"] = {}
        log_agent = self.coordinator.agents.get("logging")
        if log_agent:
            try:
                data["trading"] = log_agent.get_metrics()
            except Exception:
                data["trading"] = {}
        if not data["trading"]:
            data["trading"] = {
                "total_trades": 0,
                "wins": 0,
                "losses": 0,
                "profit_loss": 0.0,
                "win_rate": 0.0,
                "last_trade_result": None
            }
        # include latest price if available
        try:
            data["latest_price"] = self.coordinator.get_shared_data("latest_price")
        except Exception:
            data["latest_price"] = None
        return data

    def _render_trades(self):
        trades = self._get_recent_trades(limit=50)
        rows = ""
        for t in trades:
            rows += f"<tr><td>{t.get('timestamp','')}</td><td>{t.get('symbol','')}</td><td>{t.get('side','')}</td><td>{t.get('quantity','')}</td><td>{t.get('price','')}</td><td>{t.get('status','')}</td></tr>"
        return f"""
        <!DOCTYPE html>
        <html><head><title>Trades</title></head>
        <body style="font-family: Arial, sans-serif; margin: 20px;">
            <h2>Recent Trades</h2>
            <a href="/" style="margin-right:10px;">Dashboard</a>
            <a href="/config">Config</a>
            <table style="width:100%; border-collapse:collapse;" border="1" cellpadding="6">
                <tr><th>Time</th><th>Symbol</th><th>Side</th><th>Qty</th><th>Price</th><th>Status</th></tr>
                {rows}
            </table>
        </body></html>
        """

    def _render_wallet(self):
        snapshot = self._get_wallet_snapshot()
        items = "".join([f"<li>{k}: {v}</li>" for k, v in snapshot.items()]) if snapshot else "<li>No wallet data.</li>"
        # render deposit address and quick-buy form
        return ("""
        <!DOCTYPE html>
        <html><head><title>Wallet</title></head>
        <body style="font-family: Arial, sans-serif; margin: 20px; color: #ffd24a; background: #071026;">
            <h2>Wallet Snapshot</h2>
            <a href="/">Dashboard</a>
            <ul>{items}</ul>
            <hr/>
            <h3>Deposit</h3>
            <p>Send ETH to your watch address to top up the wallet. Use the address below in your wallet app.</p>
            <div id="depositArea">
                <code id="walletAddress">Loading address...</code>
                <button id="copyAddrBtn">Copy</button>
            </div>

            <h3>Quick Buy (market)</h3>
            <p>Buy ETH using the connected exchange. This will place a market BUY for the provided quote amount (quote currency depends on exchange).</p>
            <form id="buyForm">
                <label>Quote amount:</label>
                <input type="number" step="0.01" name="quote_amount" id="quoteAmount" placeholder="e.g. 50.00">
                <button type="submit">Buy</button>
            </form>
            <div id="buyResult"></div>

            <script>
                async function loadAddress(){
                    try{
                        const res = await fetch('/wallet/address');
                        const data = await res.json();
                        if (data.address) document.getElementById('walletAddress').innerText = data.address;
                        else document.getElementById('walletAddress').innerText = 'No address configured.';
                    }catch(e){ console.error('address load', e); document.getElementById('walletAddress').innerText = 'Error loading address'; }
                }
                document.getElementById('copyAddrBtn').addEventListener('click', async ()=>{
                    const txt = document.getElementById('walletAddress').innerText;
                    try{ await navigator.clipboard.writeText(txt); alert('Address copied'); }catch(e){ prompt('Copy address:', txt); }
                });
                document.getElementById('buyForm').addEventListener('submit', async (ev)=>{
                    ev.preventDefault();
                    const amt = Number(document.getElementById('quoteAmount').value || 0);
                    if (!amt || amt <= 0){ alert('Enter a valid amount'); return; }
                    const res = await fetch('/wallet/buy', { method: 'POST', headers: {'Content-Type':'application/x-www-form-urlencoded'}, body: `quote_amount=${amt}` });
                    const j = await res.json();
                    document.getElementById('buyResult').innerText = JSON.stringify(j);
                });
                loadAddress();
            </script>
        </body></html>
        """).replace("{items}", items)

    def _render_logs(self):
        logs = []
        try:
            if self.coordinator.agents.get("logging"):
                logs = self.coordinator.agents["logging"].get_recent_logs(limit=50)
        except Exception:
            logs = []
        rows = ""
        for (_, ts, level, msg, agent) in logs:
            rows += f"<tr><td>{ts}</td><td>{level}</td><td>{agent}</td><td>{msg}</td></tr>"
        html = """
        <!DOCTYPE html>
        <html><head><title>Logs</title></head>
        <body style="font-family: Arial, sans-serif; margin: 20px;">
            <h2>Recent Logs</h2>
            <a href="/">Dashboard</a>
            <a href="/config" style="margin-left:10px;">Config</a>
            <table style="width:100%; border-collapse:collapse;" border="1" cellpadding="6">
                <tr><th>Time</th><th>Level</th><th>Agent</th><th>Message</th></tr>
                <tbody id="logsBody">
                __LOG_ROWS__
                </tbody>
            </table>

            <script>
            // Server-Sent Events for live logs
            if (!!window.EventSource) {
                try {
                    const es = new EventSource('/stream/logs');
                    es.onmessage = function(e) {
                        try {
                            const obj = JSON.parse(e.data);
                            console.debug('sse log', obj);
                            const tbody = document.getElementById('logsBody');
                            if (!tbody) return;
                            const row = document.createElement('tr');
                            row.innerHTML = `<td>${obj.ts || ''}</td><td>${obj.level || ''}</td><td>${obj.agent || ''}</td><td>${obj.msg || ''}</td>`;
                            if (tbody.firstChild) tbody.insertBefore(row, tbody.firstChild);
                            else tbody.appendChild(row);
                            while (tbody.rows.length > 200) tbody.deleteRow(200);
                        } catch (err) { console.error('SSE logs parse error', err); }
                    };
                    es.onerror = function(ev) { console.warn('SSE logs connection error', ev); };
                } catch (e) { console.error('EventSource not available for logs', e); }
            }
            </script>

        </body></html>
        """
        # substitute logs rows
        try:
            html = html.replace('__LOG_ROWS__', rows)
        except Exception:
            pass
        return html

    def _price_series(self, limit: int = 100):
        md = self.coordinator.agents.get("market_data")
        if not md:
            return [], []
        try:
            times, closes = md.fetch_closes(limit)
            labels = [datetime.fromtimestamp(t / 1000).strftime("%H:%M") for t in times]
            return labels, closes
        except Exception:
            return [], []

    def _load_config(self):
        """Load configuration from YAML file."""
        try:
            with open(self.config_path, 'r') as f:
                return yaml.safe_load(f)
        except Exception as e:
            logging.error(f"Error loading config: {e}")
            return {}

    def _load_api_keys(self):
        """Load API keys from JSON file."""
        try:
            with open(self.api_keys_path, 'r') as f:
                return json.load(f)
        except Exception as e:
            logging.error(f"Error loading API keys: {e}")
            return {}

    def _render_config(self):
        """Minimal config page to edit API keys and wallet settings."""
        config = self._load_config()
        api_keys = self._load_api_keys()

        def val(mapping, key, default=""):
            return mapping.get(key, default) if mapping else default

        return f"""
        <!DOCTYPE html>
        <html>
        <head>
            <title>Configuration - Crypto Swarm</title>
            <style>
                body {{ font-family: Arial, sans-serif; max-width: 960px; margin: 20px auto; background: #071026; color: #ffd24a; }}
                .card {{ background: #0d1730; border: 1px solid rgba(255,210,74,0.08); border-radius: 10px; padding: 18px; margin-bottom: 16px; }}
                label {{ display:block; margin: 8px 0 4px; font-weight: 600; color:#d9c786; }}
                input {{ width: 100%; padding: 8px; border-radius:6px; border:1px solid #2a3350; background:#0f1427; color:#ffd24a; }}
                button {{ padding:10px 16px; background:#ffd24a; color:#071026; border:none; border-radius:8px; font-weight:700; cursor:pointer; }}
                a {{ color:#ffd24a; }}
            </style>
        </head>
        <body>
            <h1>Configuration</h1>
            <form method="post" action="/config">
                <div class="card">
                    <h3>Exchange & Strategy</h3>
                    <label>Exchange</label>
                    <input name="exchange" value="{val(config,'exchange','kraken')}">
                    <label>Symbol</label>
                    <input name="symbol" value="{val(config,'symbol','ETH/USDT')}">
                    <label>Interval</label>
                    <input name="interval" value="{val(config,'interval','1m')}">
                </div>
                <div class="card">
                    <h3>API Keys</h3>
                    <label>Kraken API Key</label>
                    <input name="kraken_api_key" value="{val(api_keys,'kraken_api_key','')}" type="password">
                    <label>Kraken API Secret</label>
                    <input name="kraken_api_secret" value="{val(api_keys,'kraken_api_secret','')}" type="password">
                    <label>Etherscan API Key</label>
                    <input name="etherscan_api_key" value="{val(api_keys,'etherscan_api_key','')}" type="password">
                    <label>Web3 RPC URL</label>
                    <input name="web3_rpc_url" value="{val(api_keys,'web3_rpc_url','')}" type="url">
                    <label>Watch Address</label>
                    <input name="watch_address" value="{val(api_keys,'watch_address','')}" placeholder="0x...">
                    <label>ERC20 Token Address (optional)</label>
                    <input name="erc20_token_address" value="{val(api_keys,'erc20_token_address','')}" placeholder="0x...">
                </div>
                <button type="submit">Save & Apply</button>
                <p><a href="/">Back to dashboard</a></p>
            </form>
        </body>
        </html>
        """

    def _save_config(self):
        """Save configuration to files."""
        try:
            # Get form data
            data = request.form.to_dict()

            # Convert string values to appropriate types
            config_updates = {}
            api_updates = {}

            # Trading config
            config_updates.update({
                'exchange': data.get('exchange', 'binance'),
                'symbol': data.get('symbol', 'BTCUSDT'),
                'interval': data.get('interval', '1m'),
                'strategy_type': data.get('strategy_type', 'sma_crossover'),
                'quote_order_size': float(data.get('quote_order_size', 25.0)),
                'max_position_base': float(data.get('max_position_base', 0.002)),
                'risk_pct': float(data.get('risk_pct', 0.01)),
                'sma_fast': int(data.get('sma_fast', 20)),
                'sma_slow': int(data.get('sma_slow', 50)),
                'lookback': int(data.get('lookback', 500)),
                'dry_run': 'dry_run' in data,
                'binance_testnet': 'binance_testnet' in data,
            })

            # Agent config
            config_updates.update({
                'kill_switch_enabled': 'kill_switch_enabled' in data,
                'ui_enabled': 'ui_enabled' in data,
                'network_enabled': 'network_enabled' in data,
                'data_store_enabled': 'data_store_enabled' in data,
                'performance_enabled': 'performance_enabled' in data,
                'security_enabled': 'security_enabled' in data,
                'ui_host': data.get('ui_host', '0.0.0.0'),
                'ui_port': int(data.get('ui_port', 5000)),
                'redis_host': data.get('redis_host', 'localhost'),
                    'redis_port': int(data.get('redis_port', 6379)),
                    'redis_db': int(data.get('redis_db', 0)),
                    'redis_password': data.get('redis_password', ''),
                'allowed_ips': [ip.strip() for ip in data.get('allowed_ips', '').split(',') if ip.strip()],
            })

            # API keys
            api_updates.update({
                'binance_api_key': data.get('binance_api_key', ''),
                'binance_api_secret': data.get('binance_api_secret', ''),
                'kraken_api_key': data.get('kraken_api_key', ''),
                'kraken_api_secret': data.get('kraken_api_secret', ''),
                'etherscan_api_key': data.get('etherscan_api_key', ''),
                'web3_rpc_url': data.get('web3_rpc_url', ''),
                'watch_address': data.get('watch_address', ''),
                'erc20_token_address': data.get('erc20_token_address', ''),
            })

            # Load current configs
            current_config = self._load_config()
            current_api = self._load_api_keys()

            # Update configs
            current_config.update(config_updates)
            current_api.update(api_updates)

            # Save to files
            with open(self.config_path, 'w') as f:
                yaml.dump(current_config, f, default_flow_style=False)

            with open(self.api_keys_path, 'w') as f:
                json.dump(current_api, f, indent=2)

            logging.info("Configuration saved successfully")

            # Try to reload configuration in the coordinator
            try:
                from main import load_config
                new_cfg = load_config()
                self.coordinator.reload_config(new_cfg)
                success_msg = "Configuration saved and applied successfully!"
            except Exception as e:
                logging.warning(f"Could not reload configuration: {e}")
                success_msg = "Configuration saved successfully! Restart required for some changes."

            # Return success page
            return f"""
            <!DOCTYPE html>
            <html>
            <head>
                <title>Configuration Saved</title>
                <style>
                    body {{ font-family: Arial, sans-serif; text-align: center; margin: 50px; }}
                    .success {{ color: green; font-size: 24px; }}
                    .nav-button {{ display: inline-block; padding: 12px 25px; background: #007bff; color: white; text-decoration: none; border-radius: 5px; margin: 10px; }}
                </style>
            </head>
            <body>
                <div class="success">✅ {success_msg}</div>
                <p>Changes will take effect on next restart.</p>
                <a href="/" class="nav-button">🏠 Go to Dashboard</a>
                <a href="/config" class="nav-button">⚙️ Edit Configuration</a>
            </body>
            </html>
            """

        except Exception as e:
            logging.error(f"Error saving config: {e}")
            return f"""
            <!DOCTYPE html>
            <html>
            <head>
                <title>Error</title>
                <style>
                    body {{ font-family: Arial, sans-serif; text-align: center; margin: 50px; }}
                    .error {{ color: red; font-size: 24px; }}
                </style>
            </head>
            <body>
                <div class="error">❌ Error saving configuration: {str(e)}</div>
                <a href="/config">Try again</a>
            </body>
            </html>
            """, 500

    def start(self):
        self.thread = threading.Thread(target=self._run_server, daemon=True)
        self.thread.start()
        logging.info(f"UI Agent started on http://{self.host}:{self.port}")

    def _run_server(self):
        self.app.run(host=self.host, port=self.port, debug=False, use_reloader=False)

    def stop(self):
        if self.thread:
            logging.info("UI Agent stopping...")
