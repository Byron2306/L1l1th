                        </div>

                        <div style="margin-top:10px;">
                            <form method="post" action="/enable_network" style="display:inline-block; margin-right:10px;">
                                <input type="hidden" name="redis_host" value="{config.get('redis_host', 'localhost')}">
                                <input type="hidden" name="redis_port" value="{config.get('redis_port', 6379)}">
                                <input type="hidden" name="redis_db" value="{config.get('redis_db', 0)}">
                                <input type="hidden" name="redis_password" value="{config.get('redis_password', '')}">
                                <button type="submit" class="nav-button">🔌 Connect to Redis Now</button>
                            </form>
