import psutil
import time
import logging
from datetime import datetime, timedelta
from typing import Dict, Any, List, Optional
import statistics


class PerformanceAgent:
    """
    Performance Agent: Evaluates system and strategy performance, provides optimization insights.
    """

    def __init__(self):
        self.start_time = time.time()
        self.cpu_history = []
        self.memory_history = []
        self.response_times = []
        self.strategy_performance = {}
        logging.info("Performance Agent initialized")

    def track_system_metrics(self):
        """Track CPU and memory usage."""
        cpu = psutil.cpu_percent(interval=1)
        memory = psutil.virtual_memory().percent
        self.cpu_history.append((datetime.now(), cpu))
        self.memory_history.append((datetime.now(), memory))
        # Keep last 100 readings
        self.cpu_history = self.cpu_history[-100:]
        self.memory_history = self.memory_history[-100:]
        logging.debug(f"System metrics: CPU {cpu}%, Memory {memory}%")

    def track_response_time(self, operation: str, start_time: float):
        """Track response time for operations."""
        elapsed = time.time() - start_time
        self.response_times.append((operation, elapsed))
        self.response_times = self.response_times[-100:]
        logging.debug(f"Response time for {operation}: {elapsed:.4f}s")

    def evaluate_strategy_performance(self, trades: List[Dict[str, Any]], strategy_type: str) -> Dict[str, Any]:
        """Evaluate performance of a specific strategy."""
        if not trades:
            return {"error": "No trades to evaluate"}

        wins = [t for t in trades if t.get('profit_loss', 0) > 0]
        losses = [t for t in trades if t.get('profit_loss', 0) <= 0]
        total_pnl = sum(t.get('profit_loss', 0) for t in trades)
        win_rate = len(wins) / len(trades) if trades else 0

        # Calculate drawdown
        peak = 0
        drawdown = 0
        current_pnl = 0
        for trade in trades:
            current_pnl += trade.get('profit_loss', 0)
            peak = max(peak, current_pnl)
            drawdown = max(drawdown, peak - current_pnl)

        # Sharpe ratio (simplified, assuming daily returns)
        if len(trades) > 1:
            returns = [t.get('profit_loss', 0) for t in trades]
            avg_return = statistics.mean(returns)
            std_return = statistics.stdev(returns) if len(returns) > 1 else 0
            sharpe = avg_return / std_return if std_return > 0 else 0
        else:
            sharpe = 0

        perf = {
            "strategy": strategy_type,
            "total_trades": len(trades),
            "wins": len(wins),
            "losses": len(losses),
            "win_rate": win_rate,
            "total_pnl": total_pnl,
            "max_drawdown": drawdown,
            "sharpe_ratio": sharpe,
            "avg_trade_pnl": total_pnl / len(trades) if trades else 0
        }
        self.strategy_performance[strategy_type] = perf
        return perf

    def compare_strategies(self, strategies: List[str]) -> Dict[str, Any]:
        """Compare performance across strategies."""
        comparison = {}
        for strat in strategies:
            if strat in self.strategy_performance:
                comparison[strat] = self.strategy_performance[strat]
        # Find best by win rate and pnl
        if comparison:
            best_win_rate = max(comparison, key=lambda x: comparison[x]['win_rate'])
            best_pnl = max(comparison, key=lambda x: comparison[x]['total_pnl'])
            return {
                "comparison": comparison,
                "best_win_rate": best_win_rate,
                "best_pnl": best_pnl
            }
        return {"error": "No strategies to compare"}

    def get_system_efficiency(self) -> Dict[str, Any]:
        """Get current system efficiency metrics."""
        uptime = time.time() - self.start_time
        avg_cpu = statistics.mean([x[1] for x in self.cpu_history]) if self.cpu_history else 0
        avg_memory = statistics.mean([x[1] for x in self.memory_history]) if self.memory_history else 0
        avg_response = statistics.mean([x[1] for x in self.response_times]) if self.response_times else 0

        return {
            "uptime_seconds": uptime,
            "avg_cpu_percent": avg_cpu,
            "avg_memory_percent": avg_memory,
            "avg_response_time": avg_response,
            "total_operations": len(self.response_times)
        }

    def generate_optimization_suggestions(self) -> List[str]:
        """Generate suggestions based on performance."""
        suggestions = []
        sys_eff = self.get_system_efficiency()

        if sys_eff['avg_cpu_percent'] > 80:
            suggestions.append("High CPU usage detected. Consider optimizing loops or using background threads.")
        if sys_eff['avg_memory_percent'] > 80:
            suggestions.append("High memory usage. Check for memory leaks or reduce data caching.")
        if sys_eff['avg_response_time'] > 1.0:
            suggestions.append("Slow response times. Optimize API calls or data processing.")

        for strat, perf in self.strategy_performance.items():
            if perf['win_rate'] < 0.5:
                suggestions.append(f"Strategy {strat} has low win rate ({perf['win_rate']:.2%}). Consider adjusting parameters.")
            if perf['max_drawdown'] > 100:
                suggestions.append(f"Strategy {strat} has high drawdown (${perf['max_drawdown']:.2f}). Increase risk controls.")

        if not suggestions:
            suggestions.append("System performance is good. No immediate optimizations needed.")
        return suggestions

    def get_performance_report(self) -> Dict[str, Any]:
        """Generate a full performance report."""
        return {
            "system_efficiency": self.get_system_efficiency(),
            "strategy_performance": self.strategy_performance,
            "optimization_suggestions": self.generate_optimization_suggestions(),
            "timestamp": datetime.now().isoformat()
